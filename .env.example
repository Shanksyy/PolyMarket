# ─── Anthropic (required) ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Polymarket (required for live trading) ──────────────────────────────────
# Your Polygon/Ethereum private key (wallet that holds USDC on Polygon)
POLYGON_PRIVATE_KEY=0x...
# Derive these after first run (the bot will print them)
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# ─── Twitter / X (optional — enhances signal quality) ────────────────────────
TWITTER_BEARER_TOKEN=

# ─── Telegram (optional — scrapes public channels) ───────────────────────────
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Comma-separated public channel usernames to monitor
TELEGRAM_CHANNELS=polymarket,predictionmarkets,cryptonews,worldnews

# ─── News APIs (optional — free tiers work) ──────────────────────────────────
NEWS_API_KEY=
# CryptoPanic (free tier available at cryptopanic.com)
CRYPTOPANIC_API_KEY=

# ─── Risk Management ─────────────────────────────────────────────────────────
# Maximum USD to risk on a single position
MAX_POSITION_SIZE_USD=50
# Maximum total USD exposure across all open positions
MAX_TOTAL_EXPOSURE_USD=500
# Minimum edge (Claude probability - market price) required to trade
# 0.07 = only trade when we believe the market is mis-priced by >7%
MIN_EDGE_THRESHOLD=0.07
# Minimum market liquidity (USD) — avoids illiquid markets
MIN_LIQUIDITY_USD=10000
# Maximum number of simultaneous open positions
MAX_POSITIONS=10

# ─── Bot Behaviour ────────────────────────────────────────────────────────────
# How many minutes between full market scans
SCAN_INTERVAL_MINUTES=15
# Set to "true" to simulate trades without executing them
DRY_RUN=true
# Minimum confidence level to trade: low | medium | high
MIN_CONFIDENCE=medium
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
